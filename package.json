{
  "name": "deal-grabber",
  "version": "1.0.0",
  "private": true,
  "description": "Amazon to Flipkart Deals Grabber — live tech deals scraped from Amazon.in and Flipkart into a static, SEO-ready frontend.",
  "scripts": {
    "start": "node server.js",
    "scrape": "node server.js --once",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "deploy": "wrangler pages deploy",
    "icons": "node scripts/generate-icons.mjs",
    "provision": "node scripts/provision-push.mjs",
    "push": "node scripts/send-daily-push.js",
    "push:dry": "node scripts/send-daily-push.js --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
